{
  "name": "mdlint",
  "displayName": "mdLint",
  "description": "使用 @lint-md/cli 为 Markdown 文件提供格式规则检查。",
  "version": "1.0.2",
  "author": "wdssmq",
  "publisher": "wdssmq",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wdssmq/vscode-plugin-mdLint"
  },
  "categories": [
    "Linters"
  ],
  "keywords": [
    "Markdown"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "activationEvents": [
    "onLanguage:plaintext"
  ],
  "icon": "vscode-logo.png",
  "main": "./client/out/extension",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "mdLint",
      "properties": {
        "mdLintServer.num": {
          "scope": "resource",
          "type": "number",
          "default": 100,
          "description": "Just A Number"
        },
        "mdLintServer.trace.server": {
          "scope": "window",
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the language server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -b",
    "watch": "tsc -b -w",
    "test": "pnpm run compile && node ./client/out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^8.2.2",
    "@types/node": "^12.12.0",
    "mocha": "^8.3.2",
    "typescript": "^4.3.5"
  }
}
